    {
      "id": "7a6de93a-1676-4586-b87c-1a5bd4085eb6",
      "name": "Build Briefs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const clients = $('Get Active Clients').all().map(i => i.json);\nconst posts = $('Get Recent Posts').all().map(i => i.json).filter(p => p && p.post_id);\nconst stamp = $now.toFormat('yyyyLLdd');\nconst out = [];\nfor (const s of clients) {\n  const mine = posts.filter(p => p.client_key === s.client_key);\n  const waiting = mine.filter(p => ['drafting', 'awaiting_approval', 'awaiting_edit'].includes(p.status)).length;\n  if (waiting >= 3) continue;\n  const recent = mine.filter(p => p.topic).slice(0, 15).map(p => '- ' + p.topic);\n  out.push({ json: {\n    client_key: s.client_key,\n    post_id: s.client_key + '-' + stamp + '-' + Math.random().toString(36).slice(2, 8),\n    brand_name: s.brand_name,\n    brand_voice: s.brand_voice,\n    audience: s.audience,\n    themes: String(s.themes || '').split('|').map(t => '- ' + t.trim()).filter(t => t.length > 2).join('\\n'),\n    base_hashtags: s.base_hashtags,\n    recent_topics: recent.length ? recent.join('\\n') : '(none yet)',\n    today: $now.toFormat('cccc d LLLL yyyy')\n  } });\n}\nreturn out;"
      }
    },
    {
      "id": "e96039d8-f95f-46ca-a74a-77cfed1b0322",
      "name": "Write Post",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        900,
        300
      ],
      "parameters": {
        "promptType": "define",
        "hasOutputParser": true,
        "text": "=Write the next Instagram post for {{ $json.brand_name }}.\n\nToday: {{ $json.today }}\n\nWho reads it:\n{{ $json.audience }}\n\nThemes to draw from (pick ONE, or an angle on it that fits today):\n{{ $json.themes }}\n\nTopics already used recently (do not repeat these angles):\n{{ $json.recent_topics }}\n\nHashtags that must close every caption: {{ $json.base_hashtags }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "=You write social posts for a small business, in its own voice.\n\nVoice: {{ $json.brand_voice }}\n\nRules for the caption:\n- First line is the hook: under 80 characters, no hashtags, no emoji at the start.\n- 60 to 140 words in total before the hashtags, in short paragraphs separated by a blank line.\n- Explain one concrete mechanism: what happens, step by step, for the business owner.\n- Never promise results, revenue, rankings or follower numbers. Any number must be clearly an example (\"say you miss five calls a week\").\n- Never invent clients, quotes, reviews or statistics.\n- End with one soft call to action (for example: book a 15-minute call, link in bio).\n- Then a blank line and the hashtags: the required ones plus 2 to 4 specific ones, 8 at most in total.\n- Whole caption under 1,000 characters.\n\nRules for image_prompt: describe only the content of one simple scene or visual metaphor for the post: the objects, how they are arranged, and the mood. Do NOT name colours, palettes, backgrounds, lighting or an art style; the brand's visual style is added separately and must not be contradicted. No words, letters, numbers, logos or screens with readable text in the image. No people's faces.\n\nalt_text: one plain sentence describing the illustration for screen readers."
            }
          ]
        }
      }
    },
    {
