      "name": "Shape Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Rows changed since `since` (ms), oldest first. The inbox asks again with since = next\n// and merges by wamid (rows with the same updated_ms can repeat across pages).\nconst rows = $input.all().map((i) => i.json).filter((r) => r && r.wamid);\nconst since = Number($('GET messages').first().json.query.since ?? 0) || 0;\nconst next = rows.length ? rows[rows.length - 1].updated_ms : since;\nreturn [{ json: { rows, next } }];"
      }
    },
