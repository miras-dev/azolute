    {
      "id": "cb9c2164-b059-4931-b6cc-2081346aee23",
      "name": "Clean Imported Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        1280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Old chats from Twilio's log, one item per message, on Azolute's number.\n// updated_ms is now, so a running inbox picks them up on its next poll (it sorts by `at`).\nconst pid = String($('Hub Settings (import)').first().json.azolute_phone_number_id ?? '');\nconst s = (v, n) => String(v ?? '').slice(0, n);\nconst rows = $('POST import').first().json.body?.rows;\nconst now = Date.now();\nconst out = [];\nfor (const r of Array.isArray(rows) ? rows.slice(0, 1000) : []) {\n  if (!r || !r.wamid) continue;\n  out.push({ json: {\n    wamid: s(r.wamid, 200), direction: r.direction === 'out' ? 'out' : 'in', phone_number_id: pid,\n    contact: s(r.contact, 20).replace(/\\D/g, ''), contact_name: s(r.contact_name, 100), type: s(r.type || 'text', 20),\n    text: s(r.text, 4096), status: s(r.status, 20), error: s(r.error, 500), source: 'twilio-import',\n    media_mime: s(r.media_mime, 100), at: s(r.at, 40), updated_ms: now,\n  } });\n}\nreturn out;"
      }
    },
