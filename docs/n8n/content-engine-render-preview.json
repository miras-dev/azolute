    {
      "id": "cebc6b65-4d1e-45e0-909f-af96b4ab3900",
      "name": "Send Preview To Owner",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        2440,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendTemplate",
        "phoneNumberId": "={{ $('Get Settings').first().json.wa_phone_number_id }}",
        "recipientPhoneNumber": "={{ $('Get Settings').first().json.owner_whatsapp }}",
        "template": "={{ $('Get Settings').first().json.wa_template_name }}|{{ $('Get Settings').first().json.wa_template_lang }}",
        "components": {
          "component": [
            {
              "type": "header",
              "headerParameters": {
                "parameter": [
                  {
                    "type": "image",
                    "imageLink": "={{ $json.media_url }}"
                  }
                ]
              }
            },
            {
              "type": "body",
              "bodyParameters": {
                "parameter": [
                  {
                    "type": "text",
                    "text": "={{ String($json.topic || 'New post').replace(/\\s+/g, ' ').trim().slice(0, 60) }}"
                  },
                  {
                    "type": "text",
                    "text": "={{ (() => { const c = String($json.caption || '').replace(/\\s*\\n+\\s*/g, ' / ').replace(/\\s{2,}/g, ' ').trim(); return c.length > 850 ? c.slice(0, 850) + '…' : c; })() }}"
                  }
                ]
              }
            },
            {
              "type": "button",
              "sub_type": "quick_reply",
              "index": 0,
              "buttonParameters": {
                "parameter": {
                  "type": "payload",
                  "payload": "=approve:{{ $json.post_id }}"
                }
              }
            },
            {
              "type": "button",
              "sub_type": "quick_reply",
              "index": 1,
              "buttonParameters": {
                "parameter": {
                  "type": "payload",
                  "payload": "=edit:{{ $json.post_id }}"
                }
              }
            },
            {
              "type": "button",
              "sub_type": "quick_reply",
              "index": 2,
              "buttonParameters": {
                "parameter": {
                  "type": "payload",
                  "payload": "=skip:{{ $json.post_id }}"
                }
              }
            }
          ]
        }
      },
      "onError": "continueErrorOutput",
      "webhookId": "629d2706-897b-404b-8916-594bbb379fd1"
    },
