    {
      "id": "571f8ecb-b36b-4dbf-b479-720b4e7b2129",
      "name": "Split Into Messages And Statuses",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        384
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One item per message and per status update, in the wa_messages shape.\nconst digits = (s) => String(s ?? '').replace(/\\D/g, '');\nconst iso = (ts) => (ts ? new Date(Number(ts) * 1000) : new Date()).toISOString();\nconst settings = $('Load Hub Settings').first().json;\nconst out = [];\nfor (const item of $('WhatsApp In').all()) {\n  const v = item.json.value ?? item.json;\n  const pid = String(v.metadata?.phone_number_id ?? '');\n  const names = {};\n  for (const c of v.contacts ?? []) names[c.wa_id] = c.profile?.name ?? '';\n  for (const m of v.messages ?? []) {\n    const media = m.image ?? m.audio ?? m.video ?? m.document ?? m.sticker ?? null;\n    const payload = m.button?.payload ?? m.interactive?.button_reply?.id ?? m.interactive?.list_reply?.id ?? '';\n    // A café owner's Confirm / Decline tap, on Azolute's own number only.\n    const cafe = /^toasty:(confirm|decline):[A-Za-z0-9]+$/.test(payload) && pid !== '' && pid === String(settings.azolute_phone_number_id ?? '');\n    out.push({ json: {\n      kind: 'message', wamid: m.id, direction: 'in', phone_number_id: pid,\n      contact: digits(m.from), contact_name: names[m.from] ?? '', type: m.type ?? '',\n      text: m.text?.body ?? media?.caption ?? m.button?.text ?? m.interactive?.button_reply?.title ?? m.interactive?.list_reply?.title ?? m.location?.name ?? '',\n      payload, media_id: media?.id ?? '', media_mime: media?.mime_type ?? '',\n      error: m.errors?.[0]?.title ?? '', at: iso(m.timestamp), updated_ms: Date.now(),\n      route: cafe ? 'toasty' : 'other',\n      // The original webhook value with only this message: what Owner Replies reads.\n      value: { messaging_product: v.messaging_product, metadata: v.metadata, contacts: (v.contacts ?? []).filter((c) => c.wa_id === m.from), messages: [m] },\n    } });\n  }\n  for (const s of v.statuses ?? []) {\n    const e = s.errors?.[0];\n    out.push({ json: {\n      kind: 'status', wamid: s.id, direction: 'out', phone_number_id: pid,\n      contact: digits(s.recipient_id), status: s.status ?? '',\n      error: e ? (e.error_data?.details ?? e.message ?? e.title ?? 'error') + ' (' + (e.code ?? '') + ')' : '',\n      source: s.biz_opaque_callback_data ?? '', at: iso(s.timestamp), updated_ms: Date.now(),\n    } });\n  }\n}\nreturn out;\n"
      }
    },
