{
  "name": "Azolute · Rückruf (DE)",
  "nodes": [
    {
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        416,
        384
      ],
      "parameters": {
        "content": "## Azolute · Rückruf (DE)\nThe call-back form on **azolute.one/de/** posts here.\n\n1. A filled honeypot (`website`) is answered OK and dropped.\n2. Without consent, one valid email address, a real phone number or a name: 400, nothing stored.\n3. Otherwise the request and the **exact consent wording and time** go into `callback_requests` (the proof that a call is allowed, UWG § 7), the browser gets OK and Miras gets an email.\n\nNo email goes to the address in the form (it would let anyone send mail from Miras's address). Successful runs are not saved, so deleting a row deletes the request.\n\nUnpublished until launch: docs/de-launch-checklist.md",
        "color": 5,
        "width": 620,
        "height": 300
      }
    },
    {
      "name": "Rückruf Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        96
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "azolute-rueckruf",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://azolute.one,http://localhost:8000"
        }
      }
    },
    {
      "name": "Bot?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ String($json.body.website || '').length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "name": "Respond OK (bot, nothing stored)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        448,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}"
      }
    },
    {
      "name": "Valid With Consent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        192
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.consent === true && /^[^\\s@,;<>()\"']+@[^\\s@,;<>()\"']+\\.[^\\s@,;<>()\"']+$/.test(String($json.body.email || '').trim()) && String($json.body.email || '').trim().length <= 200 && /^\\+?\\d{6,15}$/.test(String($json.body.phone || '').replace(/\\(0\\)/g, '').replace(/[\\s\\-\\/().]/g, '')) && String($json.body.name || '').trim().length > 0 && String($json.body.consent_text || '').trim().length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
